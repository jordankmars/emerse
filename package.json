{
	"name": "repousse",
	"version": "1.0.1",
	"description": "Press and hold an item to lift it above a blurred page, with a menu next to it.",
	"keywords": [
		"react",
		"menu",
		"context-menu",
		"long-press",
		"press-and-hold",
		"touch",
		"gesture"
	],
	"homepage": "https://github.com/jordankmars/repousse#readme",
	"bugs": {
		"url": "https://github.com/jordankmars/repousse/issues"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/jordankmars/repousse.git"
	},
	"author": "Jordan Mars",
	"license": "MIT",
	"type": "module",
	"sideEffects": false,
	"files": [
		"dist"
	],
	"exports": {
		"./react": {
			"types": "./dist/react/index.d.mts",
			"import": "./dist/react/index.mjs"
		},
		"./package.json": "./package.json"
	},
	"scripts": {
		"build": "tsdown",
		"dev": "tsdown --watch",
		"typecheck": "tsc --noEmit",
		"test": "vitest run",
		"playground": "vite playground",
		"site:dev": "pnpm build && pnpm --filter site dev",
		"site:build": "pnpm build && pnpm --filter site build",
		"prepack": "pnpm build",
		"lint": "biome check .",
		"format": "biome check --write ."
	},
	"peerDependencies": {
		"react": ">=18",
		"react-dom": ">=18"
	},
	"peerDependenciesMeta": {
		"react": {
			"optional": true
		},
		"react-dom": {
			"optional": true
		}
	},
	"packageManager": "pnpm@10.15.1",
	"engines": {
		"node": ">=20"
	},
	"devDependencies": {
		"@arethetypeswrong/core": "^0.18.5",
		"@biomejs/biome": "2.6.6",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@vitejs/plugin-react": "^6.2.1",
		"jsdom": "^31.0.0",
		"publint": "^0.3.25",
		"react": "^19.3.1",
		"react-dom": "^19.3.1",
		"tsdown": "^0.23.7",
		"typescript": "^7.0.2",
		"vite": "^8.3.6",
		"vitest": "^5.1.0"
	}
}
